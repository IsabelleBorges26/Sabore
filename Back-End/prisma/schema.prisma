
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plano {
  FREE
  PRO
}

enum TipoDesafio {
  HASHTAG
  CRIATIVIDADE
  META
}

enum StatusDesafio {
  RASCUNHO
  INSCRICOES
  ENVIO
  VOTACAO
  ENCERRADO
}

model Usuario {
  id                      Int                     @id @default(autoincrement())
  nome                    String
  email                   String                  @unique
  senha                   String
  foto                    String?
  plano                   Plano                   @default(FREE)
  molduraAtiva            String?
  isAdmin                 Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  receitas                Receita[]
  favoritos               Favorito[]
  avaliacoes              Avaliacao[]
  comentarios             Comentario[]
  ingredientesDisponiveis IngredienteDisponivel[]
  livros                  Livro[]
  compartilhamentos       Compartilhamento[]
  seguindo                Seguidor[]              @relation("Seguidor")
  seguidores              Seguidor[]              @relation("Seguido")
  atividadesEngajamento   AtividadeEngajamento[]
  concessoesPro           ConcessaoPro[]
  usosIA                  UsoIA[]
  fechamentosExecutados   FechamentoMensal[]
  desafiosParticipacoes  DesafioParticipacao[]
  desafiosCriados        Desafio[]              @relation("CriadorDesafio")
  desafiosEntradas       DesafioEntrada[]
  desafiosVotos          DesafioVoto[]
  conquistas             ConquistaUsuario[]
  participacoesDesafio    ParticipacaoDesafio[]
}

model Receita {
  id                Int                  @id @default(autoincrement())
  titulo            String
  descricao         String?              @db.Text
  modoPreparo       String               @db.Text
  tempoPreparo      Int?
  publica           Boolean              @default(false)
  publicadaEm       DateTime?
  imagem            String?              @db.Text
  dificuldade       String?
  criadaPorIA       Boolean              @default(false)
  rascunho          Boolean              @default(false)
  linkImportacao    String?
  usuarioId         Int
  livroId           Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  usuario           Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro             Livro?               @relation(fields: [livroId], references: [id], onDelete: Cascade)
  ingredientes      ReceitaIngrediente[]
  categorias        ReceitaCategoria[]
  hashtags          ReceitaHashtag[]
  favoritos         Favorito[]
  avaliacoes        Avaliacao[]
  comentarios       Comentario[]
  compartilhamentos Compartilhamento[]
  desafiosEntradas  DesafioEntrada[]
}

model Ingrediente {
  id             Int                     @id @default(autoincrement())
  nome           String                  @unique
  receitas       ReceitaIngrediente[]
  disponivelPara IngredienteDisponivel[]
}

model ReceitaIngrediente {
  id            Int         @id @default(autoincrement())
  quantidade    String
  receitaId     Int
  ingredienteId Int
  receita       Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([receitaId, ingredienteId])
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  receitaId Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita   Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, receitaId])
  @@index([receitaId])
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  nota       Int
  comentario String?
  usuarioId  Int
  receitaId  Int
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita    Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, receitaId])
  @@index([receitaId])
}

model Comentario {
  id         Int      @id @default(autoincrement())
  texto      String   @db.Text
  nota       Int?
  usuarioId  Int
  receitaId  Int
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita    Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([receitaId, createdAt])
  @@index([usuarioId, receitaId])
}

model Categoria {
  id       Int                @id @default(autoincrement())
  nome     String             @unique
  receitas ReceitaCategoria[]
}

model ReceitaCategoria {
  id          Int       @id @default(autoincrement())
  receitaId   Int
  categoriaId Int
  receita     Receita   @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([receitaId, categoriaId])
}

model Hashtag {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  receitas  ReceitaHashtag[]
  createdAt DateTime         @default(now())
}

model ReceitaHashtag {
  id         Int      @id @default(autoincrement())
  receitaId  Int
  hashtagId  Int
  receita    Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([receitaId, hashtagId])
  @@index([hashtagId])
}

model IngredienteDisponivel {
  id            Int         @id @default(autoincrement())
  usuarioId     Int
  ingredienteId Int
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ingredienteId])
}

model Livro {
  id        Int       @id @default(autoincrement())
  titulo    String
  emoji     String    @default("fa-solid fa-book")
  tag       String    @default("Pessoal")
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receitas  Receita[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Compartilhamento {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  receitaId Int
  usuarioId Int
  createdAt DateTime @default(now())
  receita   Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([receitaId])
}

model Seguidor {
  id         Int      @id @default(autoincrement())
  seguidorId Int
  seguidoId  Int
  createdAt  DateTime @default(now())
  seguidor   Usuario  @relation("Seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido    Usuario  @relation("Seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
}

model DesafioParticipacao {
  id          Int      @id @default(autoincrement())
  desafioChave String
  usuarioId   Int
  createdAt   DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([desafioChave, usuarioId])
  @@index([desafioChave])
}

model Desafio {
  id             Int                    @id @default(autoincrement())
  titulo         String
  descricao      String                  @db.Text
  hashtag        String                  @unique
  tipo           TipoDesafio
  status         StatusDesafio           @default(RASCUNHO)
  comecaEm       DateTime
  encerraEm      DateTime
  votacaoIniciaEm DateTime?
  votacaoEncerraEm DateTime?
  premioProMeses Int                    @default(0)
  emblema        String?
  molduraPerfil  String?
  bannerUrl      String?
  regras         String?                 @db.Text
  resultadoDivulgadoEm DateTime?
  resultadoConfirmado Boolean             @default(false)
  vencedorId     Int?
  criadoPorId    Int?
  createdAt      DateTime                @default(now())
  atualizadoEm   DateTime                @updatedAt
  criadoPor      Usuario?                @relation("CriadorDesafio", fields: [criadoPorId], references: [id], onDelete: SetNull)
  entradas       DesafioEntrada[]
  votos          DesafioVoto[]
}

model DesafioEntrada {
  id          Int      @id @default(autoincrement())
  desafioId   Int
  usuarioId   Int
  receitaId   Int      @unique
  status      String   @default("APROVADA")
  motivoRejeicao String?
  denuncias   Int      @default(0)
  createdAt   DateTime @default(now())
  desafio     Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita     Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  votos       DesafioVoto[]

  @@unique([desafioId, usuarioId, receitaId])
}

model DesafioVoto {
  id          Int            @id @default(autoincrement())
  desafioId   Int
  entradaId   Int
  usuarioId   Int
  createdAt   DateTime       @default(now())
  desafio     Desafio        @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  entrada     DesafioEntrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  usuario     Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([desafioId, usuarioId])
}

model ConquistaUsuario {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  desafioId   Int?
  titulo      String
  emblema     String
  molduraPerfil String?
  concedidaEm DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, concedidaEm])
}

model MensagemContato {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  assunto   String   @db.VarChar(40)
  mensagem  String   @db.Text
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lida, createdAt])
}

enum TipoEngajamento {
  RECEITA_VALIDA
  ACESSO_DIARIO
  FAVORITO_RECEBIDO
  AVALIACAO_RECEBIDA
  PERFIL_COMPLETO
  SEGUIR_USUARIO
  DESAFIO_SEMANA
}

model AtividadeEngajamento {
  id             Int             @id @default(autoincrement())
  usuarioId      Int
  tipo           TipoEngajamento
  pontos         Int
  chaveUnica     String?         @unique
  descricao      String?
  referenciaId   Int?
  mesReferencia  String
  createdAt      DateTime        @default(now())
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, mesReferencia])
  @@index([mesReferencia, createdAt])
}

model ConcessaoPro {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  mesReferencia String
  mesVigencia   String
  posicao       Int
  pontos        Int
  inicioEm      DateTime
  expiraEm      DateTime
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, mesVigencia])
  @@index([usuarioId, ativo])
  @@index([expiraEm])
}

model FechamentoMensal {
  id              Int      @id @default(autoincrement())
  mesReferencia   String   @unique
  executadoEm     DateTime @default(now())
  executadoPorId  Int?
  topUsuarios     Json
  totalApurado    Int      @default(0)
  observacoes     String?
  executadoPor    Usuario? @relation(fields: [executadoPorId], references: [id], onDelete: SetNull)
}

enum ModalidadeIA {
  CHAT
  IMAGEM
  VIDEO
}

model UsoIA {
  id            Int          @id @default(autoincrement())
  usuarioId     Int
  modalidade    ModalidadeIA
  planoNoUso    Plano
  mesReferencia String
  semanaChave   String
  createdAt     DateTime     @default(now())
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, mesReferencia, modalidade])
  @@index([usuarioId, semanaChave])
}


model DesafioSemana {
  id               Int                   @id @default(autoincrement())
  semanaChave      String                @unique
  titulo           String
  descricao        String
  tema             String
  orientacoes      String
  hashtag          String?
  imagem           String?
  pontosRecompensa Int                   @default(30)
  ativo            Boolean               @default(true)
  inicioEm         DateTime
  fimEm            DateTime
  createdAt        DateTime              @default(now())
  participacoes    ParticipacaoDesafio[]

  @@index([inicioEm])
}

model ParticipacaoDesafio {
  id                  Int           @id @default(autoincrement())
  usuarioId           Int
  desafioId           Int
  nomeReceita         String
  descricaoPreparacao String
  foto                String?
  receitaId           Int?
  pontosConcedidos    Int           @default(0)
  pontosRegistradosEm DateTime?
  createdAt           DateTime      @default(now())
  usuario             Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  desafio             DesafioSemana @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, desafioId])
  @@index([desafioId, createdAt])
}

model AuditoriaAdmin {
  id        Int      @id @default(autoincrement())
  adminId   Int
  acao      String
  alvoTipo  String
  alvoId    Int?
  detalhes  Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}
