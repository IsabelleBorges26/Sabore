// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // direcionar prisma para database no supabase
}

enum Plano {
  FREE
  PRO
}

model Usuario {
  id                      Int                     @id @default(autoincrement())
  nome                    String
  email                   String                  @unique
  senha                   String
  foto                    String?
  plano                   Plano                   @default(FREE)
  isAdmin                 Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  receitas                Receita[]
  favoritos               Favorito[]
  avaliacoes              Avaliacao[]
  ingredientesDisponiveis IngredienteDisponivel[]
  livros                  Livro[]
  compartilhamentos       Compartilhamento[]
  seguindo                Seguidor[]              @relation("Seguidor")
  seguidores              Seguidor[]              @relation("Seguido")
  atividadesEngajamento   AtividadeEngajamento[]
  concessoesPro           ConcessaoPro[]
  usosIA                  UsoIA[]
  fechamentosExecutados   FechamentoMensal[]
}

model Receita {
  id                Int                  @id @default(autoincrement())
  titulo            String
  descricao         String?              @db.Text
  modoPreparo       String               @db.Text
  tempoPreparo      Int?
  publica           Boolean              @default(false)
  publicadaEm       DateTime?
  imagem            String?              @db.Text
  dificuldade       String?
  criadaPorIA       Boolean              @default(false)
  rascunho          Boolean              @default(false)
  linkImportacao    String?
  usuarioId         Int
  livroId           Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  usuario           Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro             Livro?               @relation(fields: [livroId], references: [id], onDelete: Cascade)
  ingredientes      ReceitaIngrediente[]
  categorias        ReceitaCategoria[]
  hashtags          ReceitaHashtag[]
  favoritos         Favorito[]
  avaliacoes        Avaliacao[]
  compartilhamentos Compartilhamento[]
}

model Ingrediente {
  id             Int                     @id @default(autoincrement())
  nome           String                  @unique
  receitas       ReceitaIngrediente[]
  disponivelPara IngredienteDisponivel[]
}

model ReceitaIngrediente {
  id            Int         @id @default(autoincrement())
  quantidade    String
  receitaId     Int
  ingredienteId Int
  receita       Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([receitaId, ingredienteId])
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  receitaId Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita   Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, receitaId])
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  nota       Int
  comentario String?
  usuarioId  Int
  receitaId  Int
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita    Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, receitaId])
}

model Categoria {
  id       Int                @id @default(autoincrement())
  nome     String             @unique
  receitas ReceitaCategoria[]
}

model ReceitaCategoria {
  id          Int       @id @default(autoincrement())
  receitaId   Int
  categoriaId Int
  receita     Receita   @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([receitaId, categoriaId])
}

model Hashtag {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  receitas  ReceitaHashtag[]
  createdAt DateTime         @default(now())
}

model ReceitaHashtag {
  id         Int      @id @default(autoincrement())
  receitaId  Int
  hashtagId  Int
  receita    Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([receitaId, hashtagId])
  @@index([hashtagId])
}

model IngredienteDisponivel {
  id            Int         @id @default(autoincrement())
  usuarioId     Int
  ingredienteId Int
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ingredienteId])
}

model Livro {
  id        Int       @id @default(autoincrement())
  titulo    String
  emoji     String    @default("fa-solid fa-book")
  tag       String    @default("Pessoal")
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receitas  Receita[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Compartilhamento {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  receitaId Int
  usuarioId Int
  createdAt DateTime @default(now())
  receita   Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Seguidor {
  id         Int      @id @default(autoincrement())
  seguidorId Int
  seguidoId  Int
  createdAt  DateTime @default(now())
  seguidor   Usuario  @relation("Seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido    Usuario  @relation("Seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
}

model MensagemContato {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  assunto   String   @db.VarChar(40)
  mensagem  String   @db.Text
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lida, createdAt])
}

enum TipoEngajamento {
  RECEITA_VALIDA
  ACESSO_DIARIO
  FAVORITO_RECEBIDO
  AVALIACAO_RECEBIDA
  PERFIL_COMPLETO
  SEGUIR_USUARIO
}

model AtividadeEngajamento {
  id             Int             @id @default(autoincrement())
  usuarioId      Int
  tipo           TipoEngajamento
  pontos         Int
  chaveUnica     String?         @unique // Para evitar pontuações duplicadas e requisições repetidas
  descricao      String?
  referenciaId   Int?            // ID da receita, avaliação, seguidor, etc.
  mesReferencia  String          // Ex: "2026-10" no fuso America/Sao_Paulo
  createdAt      DateTime        @default(now())
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, mesReferencia])
  @@index([mesReferencia, createdAt])
}

model ConcessaoPro {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  mesReferencia String   // O mês em que o usuário foi premiado (ex: "2026-10")
  mesVigencia   String   // O mês de fruição do benefício (ex: "2026-11")
  posicao       Int      // 1 a 5
  pontos        Int
  inicioEm      DateTime
  expiraEm      DateTime
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, mesVigencia])
  @@index([usuarioId, ativo])
  @@index([expiraEm])
}

model FechamentoMensal {
  id              Int      @id @default(autoincrement())
  mesReferencia   String   @unique // Ex: "2026-10"
  executadoEm     DateTime @default(now())
  executadoPorId  Int?
  topUsuarios     Json     // Detalhes dos 5 vencedores e pontuações
  totalApurado    Int      @default(0)
  observacoes     String?
  executadoPor    Usuario? @relation(fields: [executadoPorId], references: [id], onDelete: SetNull)
}

enum ModalidadeIA {
  CHAT
  IMAGEM
  VIDEO
}

model UsoIA {
  id            Int          @id @default(autoincrement())
  usuarioId     Int
  modalidade    ModalidadeIA
  planoNoUso    Plano
  mesReferencia String       // Ex: "2026-10"
  semanaChave   String       // Ex: "2026-W44"
  createdAt     DateTime     @default(now())
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, mesReferencia, modalidade])
  @@index([usuarioId, semanaChave])
}

